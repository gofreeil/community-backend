{
  "kind": "collectionType",
  "collectionName": "shop_seller_products",
  "info": {
    "singularName": "shop-seller-product",
    "pluralName": "shop-seller-products",
    "displayName": "Shop · Seller Product",
    "description": "מוצרים שהקהל הגיש למכירה בקניון השיתופי חנות החירות (shop.gofreeil.com) - pending / approved / rejected. כל מוצר נושא את פרטי החנות של המוכר (store_*: שם, לוגו, טלפון - ציבוריים) ותיעוד קבלת הסכם המוכר (גרסה, זמן, IP)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "status": {
      "type": "enumeration",
      "enum": ["pending", "approved", "rejected"],
      "default": "pending",
      "required": true
    },

    "name": { "type": "string", "required": true },
    "category": { "type": "string" },
    "emoji": { "type": "string" },
    "price": { "type": "decimal", "required": true },
    "old_price": { "type": "decimal" },
    "description": { "type": "text" },
    "image": { "type": "text" },
    "images": { "type": "json" },
    "link": { "type": "string" },
    "quantity": { "type": "integer" },
    "delivery_days": { "type": "integer" },
    "commission_percent": { "type": "decimal", "default": 10 },

    "store_name": { "type": "string" },
    "store_logo": { "type": "text" },
    "store_phone": { "type": "string" },
    "store_whatsapp": { "type": "string" },
    "store_city": { "type": "string" },
    "store_website": { "type": "string" },
    "store_description": { "type": "text" },

    "seller_name": { "type": "string" },
    "seller_business": { "type": "string" },
    "seller_email": { "type": "string" },
    "seller_phone": { "type": "string" },
    "seller_id_number": { "type": "string" },
    "seller_address": { "type": "string" },
    "seller_user_id": { "type": "string" },

    "contract_accepted": { "type": "boolean", "default": false },
    "contract_version": { "type": "string" },
    "contract_accepted_at": { "type": "datetime" },
    "contract_ip": { "type": "string" },
    "contract_user_agent": { "type": "text" },

    "submitted_at": { "type": "datetime" },
    "decided_at": { "type": "datetime" },
    "decided_by": { "type": "string" },
    "rejection_reason": { "type": "text" },
    "admin_note": { "type": "text" }
  }
}
