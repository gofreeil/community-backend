HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Email (Resend via nodemailer SMTP) — נדרש למיילי אישור (למשל אמנת UECC)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@gofreeil.com

# SMS לנייד של מנהלים על כל התראת ניהול חדשה (src/utils/adminSms.ts).
# אותו מנגנון של אימות הנייד בגמ"ח הארצי - ספק אחד מספיק, לפי סדר העדיפות:
#   SMSGATE_LOGIN + SMSGATE_PASSWORD   (אפליקציית SMSGate על אנדרואיד, חינמי)
#   TRACCAR_SMS_TOKEN                  (Traccar SMS Gateway על אנדרואיד, חינמי)
#   TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_FROM (בתשלום)
# בלי אף ספק - לא נשלח כלום (ההתראה בתיבה נשארת כרגיל).
TRACCAR_SMS_TOKEN=
# אופציונלי: ADMIN_SMS_ENABLED=false מכבה; ADMIN_SMS_ROLES=... מוסיף תפקידים (super_admin וכל *_admin כלולים תמיד);
# ADMIN_SMS_INCLUDE_COORDINATORS=false מוציא את רכזי השכונות (coordinator_of);
# ADMIN_SMS_MAX_PER_HOUR=12; ADMIN_SMS_GLOBAL_MAX_PER_HOUR=80; COMMUNITY_SITE_URL=https://community.gofreeil.com

# הזמנת חבר ב-SMS מאתר חיצוני (חירות TV; src/utils/externalInvite.ts, POST /api/external-sso/invite) - אותו ספק SMS.
# אופציונלי: EXTERNAL_INVITE_ENABLED=false מכבה; EXTERNAL_INVITE_PHONE_GAP_DAYS=7 (הזמנה אחת לנייד בתקופה);
# EXTERNAL_INVITE_MAX_PER_USER_DAY=3; EXTERNAL_INVITE_MAX_PER_CLIENT_DAY=5 (כמה חשבונות מאותה כתובת רשת);
# EXTERNAL_INVITE_MAX_ATTEMPTS_DAY=12 (כולל ניסיונות שנדחו); EXTERNAL_INVITE_GLOBAL_MAX_PER_HOUR=10; EXTERNAL_INVITE_GLOBAL_MAX_PER_DAY=40;
# EXTERNAL_SITE_TV_INVITE_URL=https://.../signUp (קישור ההרשמה שב-SMS, במעבר דומיין של ה-TV)

# עריכת כיתובי האתרים מתוך האתר (public/site-editor.js, /api/site-edit/*): סוד Google Authenticator
# (base32) של סופר-אדמין. בלעדיו הגלגל מציג "לא הוגדר" ואין עריכה. הסוד היחיד - כבר לא צריך אותו באתרים עצמם.
SUPER_ADMIN_TOTP_SECRET=

# PostgreSQL
DATABASE_CLIENT=postgres
DATABASE_HOST=your-host
DATABASE_PORT=5432
DATABASE_NAME=your-db-name
DATABASE_USERNAME=your-username
DATABASE_PASSWORD=your-password
DATABASE_SSL=true
